# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# ----------------------------------------------------------------------
# Angular & Build Outputs
# ----------------------------------------------------------------------
/dist
/tmp
/out-tsc
/bazel-out
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# ----------------------------------------------------------------------
# Node & Package Managers
# ----------------------------------------------------------------------
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ----------------------------------------------------------------------
# Tailwind CSS & Build Artifacts
# ----------------------------------------------------------------------
# Ignore temporary Tailwind output/cache files if custom build scripts are used
.tailwindcss/
*.log

# ----------------------------------------------------------------------
# Environment Variables & API Secrets (IMPORTANT)
# ----------------------------------------------------------------------
# Never commit real API keys or sensitive secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Keep Angular template environment files tracked, but ignore custom local overrides
src/environments/environment.development.local.ts
src/environments/environment.local.ts

# ----------------------------------------------------------------------
# OpenAPI / Swagger Generated Artifacts (Optional)
# ----------------------------------------------------------------------
# If you run openapi-generator into a temp directory
/src/app/api/temp/

# ----------------------------------------------------------------------
# IDEs and Editors
# ----------------------------------------------------------------------
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.swp
*.swo

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# ----------------------------------------------------------------------
# Operating System & System Files
# ----------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db